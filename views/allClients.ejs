<%- include("partials/header") %>
    <div class="container">
        <div class="row text-center mb-2">
            <div class="col-md-4">

            </div>
            <div class="col-md-4">
                <a href="/"><button class="btn btn-success">Начална страница</button></a>
            </div>
            <div class="col-md-4">

            </div>
        </div>
        <div class="row text-center table-reponsive">
            <table class="table table-secondary">
                <thead class="table-primary">
                    <tr>
                        <th scope="col">Дата</th>
                        <th scope="col">Име</th>
                        <th scope="col">Телефон</th>
                        <th scope="col">Информация</th>
                        <th scope="col">Сума</th>
                        <th scope="col">Предаден</th>
                    </tr>
                </thead>
                <tbody class="table-primary">
                    <% clients.map((client)=> { %>
                        <tr class="<%= client.fixed === true ? 'table-row-color' : '' %>">
                            <td>
                                <%= client.date %>
                            </td>
                            <td>
                                <%= client.name %>
                            </td>
                            <td class="<%= client.fixed  ? '' : '' %>">
                                <a href="/search/<%= client.phone %>"
                                    class="link-dark link-underline link-underline-opacity-0">
                                    <%= client.phone %>
                                </a>
                            </td>
                            <td>
                                <%= client.information %>
                            </td>
                            <td>
                                <%= client.money %>
                            </td>
                            <td>
                                <form action="/clients/<%= client.id %>" method="Patch">
                                    <button type="submit"
                                        class="<%= client.fixed === true ? 'btn btn-outline-primary' : 'btn btn-primary' %>">
                                        <%= client.fixed===true ? 'Върни' : 'Завърши' %>
                                    </button>

                                </form>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
            <div class="d-flex justify-content-center gap-2 my-3">
                <% if (page> 1) { %>
                    <a href="/clients?page=<%= page - 1 %>" class="btn btn-outline-secondary">← Предишна</a>
                    <% } %>
                        <span class="btn disabled">Страница <%= page %> / <%= totalPages %></span>
                        <% if (page < totalPages) { %>
                            <a href="/clients?page=<%= page + 1 %>" class="btn btn-outline-secondary">Следваща →</a>
                            <% } %>
            </div>
        </div>
    </div>

    <%- include("partials/footer") %>